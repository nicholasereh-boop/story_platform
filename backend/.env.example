# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Development: leave DATABASE_URL and DB_NAME empty to use SQLite (backend/db.sqlite3).
# PostgreSQL (required in production): install it on your machine, then use either one URL ...
# DATABASE_URL=postgresql://story:story@localhost:5432/story_platform
# ... or the separate parts (used only when DATABASE_URL is empty)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173

# Used by Phase 3 (Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phase 3 ---
SITE_NAME=StoryBoard
DEFAULT_FROM_EMAIL=no-reply@example.com
# Production email (development prints emails in the terminal instead)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Number of reverse proxies in front of Django (0 locally, 1 behind Nginx)
NUM_PROXIES=0
# Optional rate overrides, e.g. THROTTLE_LOGIN=20/min
# THROTTLE_LOGIN= THROTTLE_REGISTER= THROTTLE_PASSWORD_RESET= THROTTLE_EMAIL_RESEND= THROTTLE_PROFILE_UPDATE=

# --- Phase 5: media ---
# Max size of one uploaded image in bytes (default 5 MB)
MEDIA_MAX_UPLOAD_BYTES=5242880
# Leave MEDIA_STORAGE_BUCKET empty to store files on local disk (backend/media/).
# Fill it to use S3-compatible storage (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces).
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
# Only for R2 / MinIO / Spaces, e.g. http://localhost:9000 for the local MinIO
MEDIA_STORAGE_ENDPOINT=
# Optional CDN or custom domain that serves the bucket, e.g. media.example.com
MEDIA_CDN_DOMAIN=
# THROTTLE_MEDIA_UPLOAD=60/hour
# THROTTLE_PUBLIC_READ=120/min   (public website read API, per IP)

# --- Phase 8: reader engagement ---
# Minutes a reader may edit their own comment after posting
COMMENT_EDIT_WINDOW_MINUTES=15
# Comma-separated words the spam filter rejects (whole words, case-insensitive), e.g. COMMENT_BLOCKED_WORDS=casino,viagra
COMMENT_BLOCKED_WORDS=
# THROTTLE_LIKE=60/min   THROTTLE_COMMENT=10/hour   THROTTLE_REPORT=20/hour

# --- Phase 9: analytics ---
# false = stop recording page views altogether
ANALYTICS_ENABLED=true
# The same visitor viewing the same page again within this many minutes is counted once
ANALYTICS_DEDUPE_MINUTES=30
# Raw page-view events are deleted after this many days (aggregates stay). Minimum 35.
ANALYTICS_RETENTION_DAYS=90
# Secret that hashes visitor/session ids. Leave empty to derive it from DJANGO_SECRET_KEY.
# Changing it makes every visitor "new" from then on (old events cannot be matched to new ones).
ANALYTICS_HASH_SECRET=
# THROTTLE_ANALYTICS=120/min   (page-view events, per IP)

# --- Phase 10: security and privacy ---
# Where the built-in Django admin lives (change it) and whether it exists at all in production.
DJANGO_ADMIN_URL=django-admin/
DJANGO_ADMIN_ENABLED=true
# Staff sessions end after this many idle minutes (everyone else keeps the 14 day session)
STAFF_SESSION_IDLE_MINUTES=120
# true = every staff member must set up two-step verification (TOTP) before using the admin
STAFF_MFA_REQUIRED=false
# Key that encrypts two-step secrets at rest. Empty = derived from DJANGO_SECRET_KEY. Changing it invalidates every
# enrolled device (staff would have to set up again), so decide once.
MFA_ENCRYPTION_KEY=
# Name shown in the authenticator app
# MFA_ISSUER=
# Audit entries older than this many days are removed by `manage.py purge_audit_logs` (minimum 30)
AUDIT_RETENTION_DAYS=365
# Keys the hash of the IP in audit entries. Empty = derived from DJANGO_SECRET_KEY.
AUDIT_HASH_SECRET=
# true = browsers only REPORT Content-Security-Policy violations (trial run)
CSP_REPORT_ONLY=false
# Image uploads allowed per user per hour (files, not requests)
MEDIA_UPLOAD_QUOTA_PER_HOUR=100
# notice (default, no banner) | opt_in (analytics off until accepted) | opt_out (on until rejected); both of the last two show a banner
PRIVACY_CONSENT_MODE=notice
# Shown on the privacy page. Fill these in before launch.
# SITE_OPERATOR_NAME=   (default: SITE_NAME)
SITE_CONTACT_EMAIL=
# YYYY-MM-DD: the day the site owner approved the privacy text
PRIVACY_POLICY_DATE=
LOG_LEVEL=INFO
# THROTTLE_ADMIN_WRITE=300/min  THROTTLE_MFA=10/10min  THROTTLE_DATA_EXPORT=3/hour  THROTTLE_ACCOUNT_DELETE=3/hour  THROTTLE_CSP_REPORT=30/min

