# Where the dev server forwards /api, /accounts and /media (default shown).
VITE_BACKEND_URL=http://localhost:8000

# Public site name and default description (page titles, footer, social cards).
VITE_SITE_NAME=StoryBoard
VITE_SITE_DESCRIPTION=Stories worth reading.

# Extension features: set to false to hide the marketplace / video tools (the backend has matching switches).
# VITE_FEATURE_MARKETPLACE=true
# VITE_FEATURE_VIDEO_TOOLS=true
